{
  "name": "mobile",
  "main": "index.ts",
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/assert-viro-fork.mjs && expo start",
    "android": "node scripts/assert-viro-fork.mjs && expo run:android",
    "ios": "node scripts/assert-viro-fork.mjs && expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-native --import ./scripts/node-test-resolve.mjs --test 'src/**/*.test.ts'",
    "viro:assert-fork": "node scripts/assert-viro-fork.mjs",
    "prebuild": "node scripts/assert-viro-fork.mjs && expo prebuild",
    "android:quest": "node scripts/assert-viro-fork.mjs && expo run:android --variant questDebug",
    "android:pico": "node scripts/assert-viro-fork.mjs && expo run:android --variant picoDebug",
    "quest": "node scripts/quest.mjs",
    "test:scripts": "node --test 'scripts/*.test.mjs'"
  },
  "dependencies": {
