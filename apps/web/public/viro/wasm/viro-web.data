    highp vec4 _output_color = _surface_diffuse_color * texture(diffuse_texture, texcoord) *
                              _surface_diffuse_intensity * vec4(1.0, 1.0, 1.0, _surface_alpha);
    
#pragma fragment_modifier_body
    
