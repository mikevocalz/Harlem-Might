{
  "name": "@acme/spatial",
  "version": "0.0.0",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./rive": {
      "react-native": "./rive/RiveStage.native.tsx",
      "default": "./rive/RiveStage.web.tsx"
    },
    "./lightcycle": "./lightcycle/index.ts",
    "./lightcycle/three": {
      "react-native": "./lightcycle/three/index.native.ts",
      "default": "./lightcycle/three/index.web.ts"
    },
    "./rive-fx": {
      "react-native": "./rive-fx/index.native.ts",
      "default": "./rive-fx/index.web.ts"
    },
    "./mcp": "./mcp/index.ts",
    "./audio": {
      "react-native": "./audio/index.native.ts",
      "default": "./audio/index.web.ts"
    },
    "./sightline": {
      "react-native": "./sightline/index.native.ts",
      "default": "./sightline/index.web.ts"
    }
  },
  "scripts": {
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'lightcycle/**/*.test.ts' 'mcp/**/*.test.ts'",
    "rive-fx:verify": "cd rive-fx/rive && rive . --verify",
    "rive-fx:inspect": "cd rive-fx/rive && rive inspect . --summary",
    "rive-fx:spinner-shot": "cd rive-fx/rive && mkdir -p build && rive . --screenshot=build/grid-core-spinner.png --advance=30"
  },
  "dependencies": {
    "@acme/theme": "workspace:*",
    "@acme/ui": "workspace:*",
    "@reactvision/react-viro": "catalog:",
    "@reactvision/viro-web-renderer": "catalog:",
    "@rive-app/react-native": "catalog:",
    "@rive-app/react-webgl2": "catalog:",
    "react-native-nitro-modules": "catalog:",
    "zustand": "catalog:",
    "@typegpu/three": "catalog:",
    "react-native-webgpu": "catalog:",
    "three": "catalog:",
    "typegpu": "catalog:",
    "react-native-audio-api": "catalog:"
  },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "eslint-config-expo": "catalog:",
    "expo": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "typescript": "catalog:",
    "@types/three": "catalog:",
    "@webgpu/types": "catalog:",
    "unplugin-typegpu": "catalog:"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  }
}
