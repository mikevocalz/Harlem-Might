# Workspace env loaded by all apps.
# Keep secrets in local .env / hosting provider env, never in git.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
EXPO_PUBLIC_APP_URL=http://localhost:3000
WEB_VITE_URL=http://localhost:5173
VITE_PAYLOAD_API_BASE=http://localhost:3000/payload-api
EXPO_PUBLIC_PAYLOAD_API_BASE=http://localhost:3000/payload-api

# Payload (server-only).
PAYLOAD_SECRET=generate-a-long-random-string
PAYLOAD_PUSH=false
# Neon Postgres — server-only; Payload uses the `payload` schema.
DATABASE_URL=postgresql://user:pass@ep-example.us-east-2.aws.neon.tech/harlem?sslmode=require

# Bunny Storage/CDN — server-only except the CDN base URL.
BUNNY_STORAGE_ZONE_NAME=your-storage-zone
BUNNY_STORAGE_REGION=ny
BUNNY_STORAGE_ACCESS_KEY=storage-zone-password
BUNNY_MEDIA_PREFIX=harlem/
NEXT_PUBLIC_BUNNY_CDN_BASE_URL=https://your-pull-zone.b-cdn.net

# ReactVision / Viro co-location.
# These are client-side project credentials used by the Viro room + replication APIs.
EXPO_PUBLIC_REACTVISION_API_KEY=
EXPO_PUBLIC_REACTVISION_PROJECT_ID=
EXPO_PUBLIC_REACTVISION_ENDPOINT=https://platform.reactvision.xyz
# Optional live pose/replication relay override. Leave blank for Viro's production default.
EXPO_PUBLIC_REACTVISION_RELAY_ENDPOINT=

# Meta Quest app identity used by Horizon OS overlays / VRActivity.
EXPO_PUBLIC_META_QUEST_APP_ID=

# Compiled Rive Grid FX library generated from packages/spatial/rive-fx/rive.
# Can be a bundled/file URI or hosted .riv URL reachable by the native runtime.
EXPO_PUBLIC_GRID_FX_RIV_URL=
NEXT_PUBLIC_GRID_FX_RIV_URL=

# Google GNM-derived MCP head GLB.
# Web may use a relative public URL; native should use an absolute reachable URL.
NEXT_PUBLIC_MCP_GNM_GLB_URL=
EXPO_PUBLIC_MCP_GNM_GLB_URL=

# Light Cycle production assets.
# Keep the real GLB portable across Viro + Three by satisfying
# packages/spatial/lightcycle/assetContract.ts (required nodes + authored clips).
NEXT_PUBLIC_LIGHTCYCLE_GLB_URL=
EXPO_PUBLIC_LIGHTCYCLE_GLB_URL=
NEXT_PUBLIC_LIGHTCYCLE_SCOREBOARD_RIV_URL=
EXPO_PUBLIC_LIGHTCYCLE_SCOREBOARD_RIV_URL=
