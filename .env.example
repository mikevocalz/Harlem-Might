# Harlem Might environment. Copy to .env (gitignored) and fill in.
# Server-only keys have no prefix; NEXT_PUBLIC_ / VITE_ / EXPO_PUBLIC_ keys
# are sent to the browser or app. Validated in packages/config/src/env.*.ts.

# ---- App ----
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WEB_VITE_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5173
EXPO_PUBLIC_APP_URL=http://localhost:8081

# ---- Database ----
# Neon Postgres — server-only; Payload uses the `payload` schema.
DATABASE_URL=postgresql://user:pass@ep-example.us-east-2.aws.neon.tech/harlem?sslmode=require
DATABASE_DIRECT_URL=                         # optional Neon direct (non-pooled) endpoint for migrations

# ---- Supabase (2026 key format; legacy anon/service_role keys are not used) ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=                # sb_publishable_…; apikey header only, not a JWT
SUPABASE_SECRET_KEY=                     # sb_secret_…; server only, bypasses RLS
SUPABASE_PROJECT_REF=                    # CI only, for supabase link / db push
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- Payload CMS ----
PAYLOAD_SECRET=                          # openssl rand -base64 48
PAYLOAD_PUSH=false
VITE_PAYLOAD_API_BASE=http://localhost:3000/payload-api
EXPO_PUBLIC_PAYLOAD_API_BASE=http://localhost:3000/payload-api

# ---- Better Auth ----
BETTER_AUTH_SECRET=                      # openssl rand -base64 32 (min 32 chars)
BETTER_AUTH_URL=http://localhost:3000

# ---- Bunny Storage/CDN — server-only except the CDN base URL ----
BUNNY_STORAGE_ZONE_NAME=your-storage-zone
BUNNY_STORAGE_REGION=ny
BUNNY_STORAGE_ACCESS_KEY=storage-zone-password
BUNNY_MEDIA_PREFIX=harlem/
NEXT_PUBLIC_BUNNY_CDN_BASE_URL=https://your-pull-zone.b-cdn.net

# ---- Maps ----
NEXT_PUBLIC_MAPBOX_TOKEN=                # pk.… URL-restricted public token (account.mapbox.com)
MAP_SERVER_TOKEN=                        # optional; secret-scoped token for server-rendered maps only

# ---- Event providers ----
TICKETMASTER_API_KEY=                    # developer.ticketmaster.com → Consumer Key; 5,000/day, 5/sec
SEATGEEK_CLIENT_ID=                      # platform.seatgeek.com
SEATGEEK_CLIENT_SECRET=                  # optional
PREDICTHQ_API_TOKEN=                     # optional; control.predicthq.com/tokens; adapter off if empty
NYC_OPEN_DATA_APP_TOKEN=                 # optional but recommended; data.cityofnewyork.us → Developer Settings
MEETUP_OAUTH_CLIENT_ID=                  # optional; Meetup Pro required; adapter off unless all four are set
MEETUP_OAUTH_CLIENT_SECRET=
MEETUP_ACCESS_TOKEN=
MEETUP_REFRESH_TOKEN=
EVENTS_SCRAPER_USER_AGENT="HarlemMightBot/1.0 (+https://harlemmight.com/bot)"

# ---- Geo (no keys) ----
GEOSEARCH_BASE_URL=https://geosearch.planninglabs.nyc/v2
HARLEM_NTA_SOURCE_URL=https://data.cityofnewyork.us/api/v3/views/9nt8-h7nd/query.geojson

# ---- Jobs ----
CRON_SECRET=                             # openssl rand -hex 32; checked on every scheduled route
EVENTS_INGEST_ENABLED=false
EVENTS_PROVIDERS_ENABLED=                # empty = every adapter whose credentials are present
EVENTS_RUN_TIMEOUT_MS=120000

# ---- Mail (auth verification, password reset, provider alerts) ----
RESEND_API_KEY=                          # resend.com; required before email verification can be turned on
EMAIL_FROM=                              # verified sender, e.g. hello@harlemmight.com
ALERT_EMAIL_TO=

# ---- Observability (optional) ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
LOG_LEVEL=info
# SENTRY_AUTH_TOKEN / SENTRY_ORG / SENTRY_PROJECT are CI build secrets, never runtime.

# ---- Spatial / XR / media (existing) ----
EXPO_PUBLIC_REACTVISION_API_KEY=
EXPO_PUBLIC_REACTVISION_PROJECT_ID=b3b81bb6-d60b-4932-b534-46f4845bfd37
EXPO_PUBLIC_REACTVISION_ENDPOINT=https://platform.reactvision.xyz
EXPO_PUBLIC_REACTVISION_RELAY_ENDPOINT=
EXPO_PUBLIC_META_QUEST_APP_ID=
EXPO_PUBLIC_GRID_FX_RIV_URL=
NEXT_PUBLIC_GRID_FX_RIV_URL=
NEXT_PUBLIC_MCP_GNM_GLB_URL=
EXPO_PUBLIC_MCP_GNM_GLB_URL=
NEXT_PUBLIC_LIGHTCYCLE_GLB_URL=
EXPO_PUBLIC_LIGHTCYCLE_GLB_URL=
NEXT_PUBLIC_LIGHTCYCLE_SCOREBOARD_RIV_URL=
EXPO_PUBLIC_LIGHTCYCLE_SCOREBOARD_RIV_URL=
